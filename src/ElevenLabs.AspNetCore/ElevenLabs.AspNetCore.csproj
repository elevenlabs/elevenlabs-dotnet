<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Hand-written companion package. The ASP.NET Core attach helper lives here, not in the core SDK,
    so that ordinary (console/worker/desktop) consumers of ElevenLabs.Net do not inherit a
    FrameworkReference on Microsoft.AspNetCore.App and are not forced to run on the ASP.NET Core
    shared framework. Only apps that opt into the attach helper reference this package.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks
      Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0.100'))"
      >net8.0;net9.0</TargetFrameworks
    >
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ElevenLabs</RootNamespace>
    <AssemblyName>ElevenLabs.AspNetCore</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <PackageId>ElevenLabs.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for the ElevenLabs .NET SDK: attach a Speech Engine server to your app's request pipeline.</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/elevenlabs/elevenlabs-dotnet</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElevenLabs\ElevenLabs.csproj" />
  </ItemGroup>
</Project>
