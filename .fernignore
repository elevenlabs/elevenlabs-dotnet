# Hand-written Speech Engine server model (the developer hosts a WebSocket server that the
# ElevenLabs API dials into). The generator produces only the client-dials-out upstream socket;
# these add the inbound-connection JWT verifier, the per-connection session/protocol, the
# standalone HttpListener server, the ASP.NET Core attach helper, and the engine resource.
src/ElevenLabs/SpeechEngine/ConversationMessage.cs
src/ElevenLabs/SpeechEngine/SpeechEngineJwtVerifier.cs
src/ElevenLabs/SpeechEngine/SpeechEngineCallbacks.cs
src/ElevenLabs/SpeechEngine/SpeechEngineCallbacksWiring.cs
src/ElevenLabs/SpeechEngine/SpeechEngineSession.cs
src/ElevenLabs/SpeechEngine/SpeechEngineWebSocketRunner.cs
src/ElevenLabs/SpeechEngine/SpeechEngineServer.cs
src/ElevenLabs/SpeechEngine/SpeechEngineResource.cs
src/ElevenLabs.Test/Unit/SpeechEngineJwtVerifierTest.cs
src/ElevenLabs.Test/Unit/SpeechEngineSessionTest.cs
src/ElevenLabs.Test/Unit/SpeechEngineResourceTest.cs
src/ElevenLabs.Test/Unit/SpeechEngineWebSocketRunnerTest.cs

# Hand-written ASP.NET Core companion package: the attach helper lives here (not in the core
# package) so ordinary consumers do not inherit the Microsoft.AspNetCore.App FrameworkReference.
src/ElevenLabs.AspNetCore/
src/ElevenLabs.AspNetCore.Test/

# Hand-written webhook signature verifier (Fern's generated verifier can't parse the compound
# `t=...,v0=...` header). The partial adds ConstructEvent to the generated WebhooksClient.
src/ElevenLabs/Webhooks/WebhookVerifier.cs
src/ElevenLabs/Webhooks/WebhooksClient.ConstructEvent.cs
src/ElevenLabs.Test/Unit/WebhookVerifierTest.cs

# Hand-written Flows CreateAndWaitAsync helpers (create a generation or template run, then poll
# GetAsync until it is completed or failed, honouring the server's Retry-After). The partials add
# CreateAndWaitAsync to the generated Image/Video/TextToSpeech/Runs clients and their interfaces.
src/ElevenLabs/Flows/
src/ElevenLabs.Test/Unit/FlowsCreateAndWaitTest.cs

# Hand-written parsed music ComposeDetailedAsync. `POST /v1/music/detailed` returns a
# `multipart/mixed` body (JSON metadata + audio) that the generated method tries to decode as JSON.
# MusicDetailed sends the same request through the root client's HTTP pipeline (exposed by the
# ElevenLabsClient partial) and splits the parts.
src/ElevenLabs/MusicDetailed/
src/ElevenLabs/ElevenLabsClient.MusicDetailed.cs
src/ElevenLabs.Test/Unit/MusicDetailedTest.cs
